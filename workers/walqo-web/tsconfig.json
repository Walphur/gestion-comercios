{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@tauri-apps/plugin-sql": ["./src/shims/pluginSql.ts"],
      "@tauri-apps/api/core": ["./src/shims/tauriCore.ts"],
      "@tauri-apps/api/app": ["./src/shims/tauriApp.ts"],
      "@tauri-apps/api/event": ["./src/shims/tauriEvent.ts"],
      "@tauri-apps/plugin-opener": ["./src/shims/tauriNoop.ts"],
      "@tauri-apps/plugin-process": ["./src/shims/tauriNoop.ts"],
      "@tauri-apps/plugin-updater": ["./src/shims/tauriNoop.ts"]
    }
  },
  "include": ["src"]
}
